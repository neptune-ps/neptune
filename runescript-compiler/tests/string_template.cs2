/// string_templates = true
/// fold_joined_string_constants = true

// Tests string templates and interpolated assignment values. The test runtime
// does not render templates, so assertions compare the assembled strings.
[test,string_templates]
def_string $a = "Hello";
def_string $he = "he";

// a template on its own is the whole string
assert_equals_obj("\<text_pronoun(he,she,they)>", "<text_pronoun(he,she,they)>");

// the template body may contain quotes without ending the string
assert_equals_obj("\<text_pronoun(sir,madam,\"\")>", "<text_pronoun(sir,madam,"")>");

// surrounded by literal text
assert_equals_obj("Good day, \<text_pronoun(sir,madam,friend)>!", "Good day, <text_pronoun(sir,madam,friend)>!");

// adjacent to tags
assert_equals_obj("\<col=ff0000>\<text_pronoun(he,she,they)>\</col>", "<col=ff0000><text_pronoun(he,she,they)></col>");

// adjacent to an expression part
assert_equals_obj("Hello \<text_pronoun(he,she,they)>", "<$a> <text_pronoun(he,she,they)>");

// multiple templates within a single string
assert_equals_obj("\<text_pronoun(he,she,they)> and \<text_pronoun(him,her,them)>", "<text_pronoun(he,she,they)> and <text_pronoun(him,her,them)>");

// a switch template with quoted branches, the quotes belong to the template and do not end the string
assert_equals_obj("\<switch,pronoun,\"\<str_he>\",\"\<str_she>\",\"\">", "<switch,pronoun,"<str_he>","<str_she>","">");

// branches may contain tags, the template ends at the matching '>'
assert_equals_obj("\<switch,int5,\<col=00ff00>green\</col>,\<col=ff0000>red\</col>,none>", "<switch,int5,<col=00ff00>green</col>,<col=ff0000>red</col>,none>");

// escaped commas and brackets are passed through untouched, they are meaningful to the client
assert_equals_obj("\<switch,int5,a\\,b,c\\>d,e>", "<switch,int5,a\,b,c\>d,e>");

// surrounded by text and an expression part
assert_equals_obj("Hello \<switch,pronoun,sir,madam,\"\">!", "<$a> <switch,pronoun,sir,madam,"">!");

// a template variable assigned from an interpolated value, then read back by a switch
assert_equals_obj("\<str_he=he>\<switch,pronoun,\"\<str_he>\",x,\"\">", "<str_he=<$he>><switch,pronoun,"<str_he>",x,"">");

// an assignment value may be any expression, every '<' in it that is not a tag is one
assert_equals_obj("\<str_c=lit and Hello>", "<str_c=<"lit"> and <$a>>");

// tags in an assignment value are kept as text
assert_equals_obj("\<str_tag=\<col=ffffff>Bob\</col>>", "<str_tag=<col=ffffff>Bob</col>>");

// cond keeps the '>' of its condition, and its branches may contain tags
assert_equals_obj("\<cond,int_5>5,\<col=00ff00>high\</col>,low>", "<cond,int_5>5,<col=00ff00>high</col>,low>");

// template variable reads with a format and a text_pronoun with a nested tag
assert_equals_obj("\<int_x:spacer> \<text_pronoun(\<col=1>sir\</col>,madam,\"\")>", "<int_x:spacer> <text_pronoun(<col=1>sir</col>,madam,"")>");

// explicit command calls with template variable prefixes, including inside assignment values
assert_equals_obj("Hello, World!", "<str_test_return_string()>");
assert_equals_obj("\<str_value=Hello, World!>", "<str_value=<str_test_return_string()>>");

// commands outside the template variable prefixes can still omit parentheses
assert_equals_obj(test_return_string(), "<test_return_string>");
