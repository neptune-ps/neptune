// verifies other literal types convert to a string properly
[test,literal_to_string]
// normal string literal
def_string $a = "hello";
assert_equals_obj("hello", $a);

// test converting identifier to string
$a = hello;
assert_equals_obj("hello", $a);

// tests that a command returning a string is not converted
// to a string literal with just the command name
$a = test_return_string;
assert_equals_obj("Hello, World!", $a);

// int literal to string
def_string $b = 1;
assert_equals_obj("1", $b);

// boolean literal to string
def_string $c = true;
assert_equals_obj("true", $c);

// coord literal to string (not implemented currently)
// def_string $d = 0_0_0_0_0;
// assert_equals_obj("0_0_0_0_0", $d);

// Copied from string_fold_join_string
[test,not_fold_joined_string_constants]
def_string $a = "Hello";
def_string $b = "world";

// constants only -> folds to 1 segment, no JoinString at all
assert_equals_obj("\<br>a\<br>b", "<br>a<br>b");

// leading constant run, trailing expression
assert_equals_obj("\<br>Hello", "<br><$a>");

// leading expression, trailing constant run
assert_equals_obj("Hello\<br>", "<$a><br>");

// adjacent expressions with no constant between them
assert_equals_obj("HelloworldHello", "<$a><$b><$a>");

// single expression part -> 1 segment, no JoinString
assert_equals_obj("Hello", "<$a>");

// empty string, and a constant that resolves to a literal
assert_equals_obj("", "");
assert_equals_obj("\"Hello\"", "<^quote><$a><^quote>");

// nested joined string inside an expression part
assert_equals_obj("Hello world!", "<$a> <$b>!");
